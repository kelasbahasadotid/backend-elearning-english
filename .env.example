# ==========================================
# SERVER & APP CONFIGURATION
# ==========================================
PORT=5000
NODE_ENV=development
APP_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000
JWT_SECRET=your_jwt_secret_key_here

# ==========================================
# DATABASE CONFIGURATION (LOCALHOST LOKAL)
# ==========================================
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=elearning_language

# ==========================================
# FIREBASE & GOOGLE AUTH CONFIGURATION
# ==========================================
FIREBASE_API_KEY=your_firebase_api_key
FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
FIREBASE_APP_ID=your_app_id
FIREBASE_MEASUREMENT_ID=your_measurement_id
GOOGLE_CLIENT_ID=your_google_web_client_id.apps.googleusercontent.com

# ==========================================
# SCALEV INTEGRATION CONFIGURATION
# ==========================================
SCALEV_CLIENT_ID=your_scalev_client_id
SCALEV_API_KEY=your_scalev_api_key
SCALEV_SIGNING_SECRET=your_scalev_signing_secret
SCALEV_WEBHOOK_SECRET=your_scalev_webhook_secret
SCALEV_STORE_ID=your_scalev_store_id

# ==========================================
# SMTP EMAIL CONFIGURATION
# ==========================================
SMTP_HOST=mail.yourdomain.com
SMTP_PORT=465
SMTP_USER=support@yourdomain.com
SMTP_PASS=your_smtp_password
SMTP_FROM=support@yourdomain.com
SMTP_FROM_NAME="Global English Support"

# ==========================================
# IMAP MAIL CONFIGURATION
# ==========================================
IMAP_HOST=mail.yourdomain.com
IMAP_PORT=993
IMAP_USER=support@yourdomain.com
IMAP_PASS=your_imap_password
